// courier_fsm.dot — the CourierServer state machine, as the code thinks of it:
//   leg   ∈ { PICKUP, DROPOFF }
//   phase ∈ { NAVIGATING, RETRY_WAIT, CANCELING }
// One phase-loop, run once per leg. Terminals reset to IDLE (edge omitted for
// legibility; reset_to_idle() runs after every ending).
//
// Render:  dot -Tpng -Gdpi=220 courier_fsm.dot -o courier_fsm.png
//          dot -Tsvg courier_fsm.dot -o courier_fsm.svg
digraph courier_fsm {
  rankdir=TB;
  bgcolor="white";
  fontname="Helvetica";
  pad="0.3";
  nodesep=0.45;
  ranksep=0.55;

  node [fontname="Helvetica", fontsize=13, style="rounded,filled",
        shape=box, penwidth=1.4, margin="0.22,0.13"];
  edge [fontname="Helvetica", fontsize=11, color="#3d4457",
        fontcolor="#3d4457", arrowsize=0.8, penwidth=1.2];

  IDLE [label="IDLE\nno job running", fillcolor="#eef1f8", color="#8a93ab",
        fontcolor="#3d4457"];

  subgraph cluster_leg {
    label="one leg  —  runs for PICKUP, then again for DROPOFF";
    fontsize=13; fontcolor="#5b4bb5"; color="#b9aef0";
    style="rounded,dashed"; margin=18;

    NAVIGATING [label="NAVIGATING\nNav2 goal in flight", fillcolor="#e7edfd",
                color="#2b5ce6", fontcolor="#1c3fae"];
    RETRY_WAIT [label="RETRY_WAIT\nretry_delay timer", fillcolor="#f0ebfd",
                color="#7048e8", fontcolor="#4c2fb8"];
    CANCELING  [label="CANCELING\nwaiting for Nav2\nto confirm", fillcolor="#fdf3e7",
                color="#c07a1f", fontcolor="#8a5410"];
    RETRIES    [label="attempts\nleft?", shape=diamond, style="filled",
                fillcolor="#f6f7fb", color="#8a93ab", fontcolor="#3d4457",
                fontsize=12, margin="0.05,0.03"];
  }

  SUCCEEDED [label="SUCCEEDED", fillcolor="#e2f4ea", color="#1b8a5a", fontcolor="#116340"];
  FAILED    [label="FAILED\nnames failed_leg", fillcolor="#fbe9e7", color="#c43d3d", fontcolor="#94271f"];
  CANCELED  [label="CANCELED\nnot a failure", fillcolor="#eef1f8", color="#8a93ab", fontcolor="#3d4457"];

  IDLE -> NAVIGATING [label="ExecuteDelivery accepted\nleg = PICKUP, attempt = 1", color="#2b5ce6", fontcolor="#1c3fae", penwidth=1.6];

  NAVIGATING -> NAVIGATING [label="Nav2 SUCCEEDED, leg = PICKUP\n→ leg = DROPOFF, attempt = 1", color="#2b5ce6", fontcolor="#1c3fae", penwidth=1.6];
  NAVIGATING -> SUCCEEDED  [label="Nav2 SUCCEEDED\nleg = DROPOFF", color="#1b8a5a", fontcolor="#116340", penwidth=1.6];

  NAVIGATING -> RETRIES    [label="Nav2 ABORTED, rejected,\nor cancelled on its own"];
  NAVIGATING -> CANCELING  [label="leg_timeout\n→ cancel own Nav2 goal", color="#c07a1f", fontcolor="#8a5410"];
  CANCELING  -> RETRIES    [label="Nav2 result CANCELED\nreason = LEG_TIMEOUT", color="#c07a1f", fontcolor="#8a5410"];

  RETRIES -> RETRY_WAIT [label="yes · attempt ≤ max_retries", color="#7048e8", fontcolor="#4c2fb8"];
  RETRIES -> FAILED     [label="no", color="#c43d3d", fontcolor="#94271f"];
  RETRY_WAIT -> NAVIGATING [label="retry_delay elapsed\nattempt + 1", color="#7048e8", fontcolor="#4c2fb8"];

  NAVIGATING -> CANCELING [label="client cancel", style=dashed, color="#8a93ab", fontcolor="#5a6072"];
  RETRY_WAIT -> CANCELED  [label="client cancel\n(no goal in flight)", style=dashed, color="#8a93ab", fontcolor="#5a6072"];
  CANCELING  -> CANCELED  [label="Nav2 result CANCELED\nreason = CLIENT_REQUEST", style=dashed, color="#8a93ab", fontcolor="#5a6072"];

}
