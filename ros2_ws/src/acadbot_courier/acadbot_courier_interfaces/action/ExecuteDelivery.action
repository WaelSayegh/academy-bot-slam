string job_id     # must match an accepted RequestDelivery response
string pickup     # re-validated here independently of the service call
string dropoff
---
bool success        # true only if both legs completed
string failed_leg   # "pickup" or "dropoff"; empty on success
string message      # human-readable result summary
---
string leg                    # "to_pickup", "to_dropoff", or "queued"
string target                 # location name currently heading to
float32 distance_left         # meters, forwarded from Nav2's own feedback
uint32 attempt                # 1-based retry count for the current leg
uint32 queue_position          # 1-based position among still-waiting jobs, 0 while active
