<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>acadbot_courier</name>
  <version>0.1.0</version>
  <description>AcadBot as a courier. A service books a delivery between two
  named locations; an action then runs it, reporting progress and stopping
  cleanly when cancelled. The driving itself is Nav2's.</description>
  <maintainer email="eliasantoun07@outlook.com">Elias Antoun</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>acadbot_courier_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>ament_index_cpp</depend>
  <depend>behaviortree_cpp</depend>

  <exec_depend>acadbot_gazebo</exec_depend>
  <exec_depend>acadbot_navigation</exec_depend>
  <exec_depend>acadbot_description</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export><build_type>ament_cmake</build_type></export>
</package>
