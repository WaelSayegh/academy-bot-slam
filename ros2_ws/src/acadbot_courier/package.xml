<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>acadbot_courier</name>
  <version>0.0.1</version>
  <description>Dispatcher/executor nodes for the AcadBot courier final project, plus their launch and YAML config.</description>
  <maintainer email="maya.fakih@inmind.ai">Maya Fakih</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>acadbot_courier_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
